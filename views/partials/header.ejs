<!-- views/partials/header.ejs -->
<% if (typeof page === 'undefined' || page !== 'auth') { %>

  <% if (locals.user && locals.user.role === 'seller') { %>
    <!-- ========================================== -->
    <!-- 1. HEADER SELLER                           -->
    <!-- ========================================== -->
    <header class="border-b border-slate-200 bg-white sticky top-0 z-10 shadow-sm">
      <div class="mx-auto max-w-7xl px-4 py-4 sm:px-6 lg:px-8 flex items-center justify-between">
        
        <!-- KIRI: Brand & Info Seller Center -->
        <div class="flex items-center gap-3">
          <a href="/seller" class="flex items-center gap-2">
            <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-blue-600 text-white shadow-sm">
              <img
                class="h-4 w-4"
                src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRJQmAp7KEiMrucNuFSDniURFfDCX6mbGlpSnqonfj501EbVNb1o_lF_JhE&s=10"
                alt="Logo Klik Yasix"
              />
            </div>
          </a>
          <div>
            <h1 class="text-base font-bold text-slate-900">Seller Center</h1>
            <p class="text-xs text-slate-400">Klik Yasix Merchant</p>
          </div>
        </div>

        <!-- KANAN: TOGGLE STATUS TOKO PERMANEN DB & PROFIL SELLER -->
        <div class="flex items-center gap-4">
          <!-- TOGGLE STATUS KANTIN -->
          <div class="flex items-center gap-3">
            <% const isOpen = locals.sellerData ? locals.sellerData.isOpen : true; %>
            <% const badgeClass = isOpen ? 'bg-emerald-50 text-emerald-700 border-emerald-200' : 'bg-rose-50 text-rose-700 border-rose-200'; %>
            <% const dotClass = isOpen ? 'bg-emerald-500 animate-pulse' : 'bg-rose-500'; %>
            
            <span class="inline-flex items-center gap-1.5 rounded-full border px-3 py-1 text-xs font-bold <%= badgeClass %>">
              <span class="h-2 w-2 rounded-full <%= dotClass %>"></span>
              <span><%= isOpen ? 'Toko Buka' : 'Toko Tutup' %></span>
            </span>

            <!-- FORM SUBMIT TOGGLE STATUS -->
            <form action="/seller/toggle-status?_method=PATCH" method="POST" class="inline">
              <button 
                type="submit"
                class="rounded-xl border border-slate-200 bg-slate-50 px-3 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-100 hover:text-slate-900 transition cursor-pointer"
              >
                <%= isOpen ? 'Tutup Toko' : 'Buka Toko' %>
              </button>
            </form>
          </div>

          <!-- INFO PROFIL SELLER & LOGOUT -->
          <div class="flex items-center gap-3 pl-3 border-l border-slate-200">
            <div class="hidden sm:block text-right">
              <p class="text-xs font-bold text-slate-900 leading-tight"><%= locals.user.name %></p>
              <p class="text-[10px] text-slate-400"><%= locals.user.email %></p>
            </div>
            <a href="/logout" class="rounded-lg p-1.5 text-slate-400 hover:bg-rose-50 hover:text-rose-600 transition" title="Logout">
              <i data-lucide="log-out" class="h-5 w-5"></i>
            </a>
          </div>
        </div>

      </div>
    </header>

  <% } else if (locals.user && locals.user.role === 'admin') { %>
    <!-- ========================================== -->
    <!-- 2. HEADER ADMIN                            -->
    <!-- ========================================== -->
    <header class="border-b border-slate-200 bg-white sticky top-0 z-10 shadow-sm">
      <div class="mx-auto max-w-7xl px-4 py-4 sm:px-6 lg:px-8 flex items-center justify-between">
        
        <!-- KIRI: Brand Admin Panel -->
        <div class="flex items-center gap-3">
          <a href="/admin" class="flex items-center gap-2">
            <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-indigo-600 text-white shadow-sm">
              <i data-lucide="shield-check" class="h-5 w-5"></i>
            </div>
          </a>
          <div>
            <h1 class="text-base font-bold text-slate-900">Admin Panel</h1>
            <p class="text-xs text-slate-400">Pengelola Klik Yasix</p>
          </div>
        </div>

        <!-- KANAN: PROFIL ADMIN & LOGOUT -->
        <div class="flex items-center gap-3">
          <div class="text-right">
            <p class="text-xs font-bold text-slate-900 leading-tight"><%= locals.user.name %></p>
            <p class="text-[10px] text-slate-400"><%= locals.user.email %></p>
          </div>
          <a href="/logout" class="rounded-lg p-1.5 text-slate-400 hover:bg-rose-50 hover:text-rose-600 transition" title="Logout">
            <i data-lucide="log-out" class="h-5 w-5"></i>
          </a>
        </div>

      </div>
    </header>

  <% } else { %>
    <!-- ========================================== -->
    <!-- 3. HEADER BUYER / GUEST (ORIGINAL)         -->
    <!-- ========================================== -->
    <header class="sticky top-0 z-50 border-b border-slate-200 bg-white/50 backdrop-blur">
      <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
        
        <!-- Brand / Logo -->
        <a href="/" class="flex items-center gap-2.5">
          <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-600 text-white shadow-sm">
            <img
              class="h-5 w-5"
              src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRJQmAp7KEiMrucNuFSDniURFfDCX6mbGlpSnqonfj501EbVNb1o_lF_JhE&s=10"
              alt="Logo Klik Yasix"
            />
          </div>
          <span class="flex flex-col text-lg font-bold leading-none text-slate-900">
            Klik
            <span class="text-xs font-bold leading-none text-blue-600">Yasix</span>
          </span>
        </a>

        <!-- Navigation Links (Desktop) -->
        <nav class="hidden items-center gap-8 text-sm font-medium text-slate-600 md:flex">
          <a
            href="/"
            class="transition-colors px-2 py-0.5 rounded-2xl hover:text-blue-600 <%= (typeof page !== 'undefined' && page === 'home') ? 'text-blue-600 font-semibold' : '' %>"
          >
            Beranda
          </a>
          <a
            href="/products"
            class="transition-colors px-2 py-0.5 rounded-2xl hover:text-blue-600 <%= (typeof page !== 'undefined' && page === 'menu') ? 'text-blue-600 font-semibold' : '' %>"
          >
            Menu
          </a>
          <a
            href="/orders"
            class="transition-colors px-2 py-0.5 rounded-2xl hover:text-blue-600 relative <%= (typeof page !== 'undefined' && page === 'orders') ? 'text-blue-600 font-semibold' : '' %>"
          >
            Pesanan
            <span class="absolute -top-1 -right-2 flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
            </span>
          </a>
        </nav>

        <!-- CTA Buttons / User Profile (Desktop) -->
        <div class="hidden items-center gap-4 md:flex">
          <% if (!locals.user) { %>
            <a
              href="/login"
              class="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-indigo-500"
            >
              Log in
            </a>
          <% } else { %>
            <div class="flex items-center gap-3">
              <div class="text-right">
                <p class="text-xs font-bold text-slate-900 leading-tight"><%= locals.user.name %></p>
                <p class="text-[10px] text-slate-400"><%= locals.user.email %></p>
              </div>
              <a href="/logout" class="rounded-lg p-1.5 text-slate-400 hover:bg-rose-50 hover:text-rose-600 transition" title="Logout">
                <i data-lucide="log-out" class="h-5 w-5"></i>
              </a>
            </div>
          <% } %>
        </div>

        <!-- Mobile Menu Toggle Button -->
        <button
          id="mobile-menu-btn"
          type="button"
          class="rounded-md p-2 text-slate-600 hover:bg-slate-100 md:hidden cursor-pointer"
          aria-label="Toggle Menu"
        >
          <i data-lucide="menu" class="h-6 w-6"></i>
        </button>
      </div>

      <!-- Mobile Dropdown Menu -->
      <div
        id="mobile-menu"
        class="hidden border-b border-slate-200 bg-white px-4 py-3 md:hidden"
      >
        <div class="flex flex-col gap-3 font-medium text-slate-600">
          <a href="/" class="py-1 hover:text-blue-600">Beranda</a>
          <a href="/products" class="py-1 hover:text-blue-600">Menu</a>
          <a
            href="/orders"
            class="py-1 hover:text-blue-600 flex items-center justify-between"
          >
            <span>Pesanan</span>
            <span class="rounded-full bg-emerald-100 px-2 py-0.5 text-xs text-emerald-700 font-semibold">1 Siap</span>
          </a>
          <hr class="border-slate-100 my-1" />
          <% if (!locals.user) { %>
            <a
              href="/login"
              class="rounded-lg bg-indigo-600 px-4 py-2 text-center text-sm font-medium text-white"
            >
              Log in
            </a>
          <% } else { %>
            <div class="flex justify-between items-center py-1">
              <div>
                <p class="text-xs font-bold text-slate-900"><%= locals.user.name %></p>
                <p class="text-[10px] text-slate-400"><%= locals.user.email %></p>
              </div>
              <a href="/logout" class="text-xs font-semibold text-rose-600">Logout</a>
            </div>
          <% } %>
        </div>
      </div>
    </header>
  <% } %>

<% } %>