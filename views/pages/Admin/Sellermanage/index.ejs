<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Kelola Seller' %></title>
  
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="bg-slate-50 font-sans antialiased flex flex-col min-h-screen">

  <main class="flex-grow mx-auto max-w-7xl w-full px-4 py-8 sm:px-6 lg:px-8">
    
    <div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <p class="text-xs font-bold tracking-wider uppercase text-indigo-600">ADMIN CONTROL CENTER</p>
        <h1 class="mt-1 text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">
          Kelola Seller & Toko
        </h1>
        <p class="mt-1 text-sm text-slate-500">
          Daftar akun penjual kantin dan status toko aktif.
        </p>
      </div>

      <div class="flex flex-col gap-2 sm:flex-row sm:items-center">
        <a
          href="/admin/sellers/new"
          class="inline-flex items-center justify-center gap-2 rounded-xl bg-indigo-600 px-4 py-2.5 text-xs font-bold text-white shadow-md shadow-indigo-100 hover:bg-indigo-700 transition active:scale-95"
        >
          <i data-lucide="plus" class="h-4 w-4"></i>
          Tambah Seller Baru
        </a>
  
        <a
          href="/admin"
          class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-xs font-bold text-slate-700 shadow-sm transition hover:bg-slate-50"
        >
          <i data-lucide="arrow-left" class="h-4 w-4"></i>
          Kembali ke Dashboard
        </a>
      </div>

    </div>

    <div class="mt-8 rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm text-slate-600">
          <thead>
            <tr class="border-b border-slate-100 bg-slate-50/70 text-xs font-bold uppercase tracking-wider text-slate-400">
              <th class="px-6 py-4">No</th>
              <th class="px-6 py-4">Nama Toko</th>
              <th class="px-6 py-4">Pemilik (Seller)</th>
              <th class="px-6 py-4">Kontak</th>
              <th class="px-6 py-4">Total Menu</th>
              <th class="px-6 py-4">Status Toko</th>
              <th class="px-6 py-4 text-right">Aksi</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% if (sellers.length === 0) { %>
              <tr>
                <td colspan="7" class="px-6 py-8 text-center text-xs text-slate-400">Belum ada seller terdaftar.</td>
              </tr>
            <% } else { %>
              <% sellers.forEach((seller, index) => { %>
                <tr class="hover:bg-slate-50/50 transition">
                  <td class="px-6 py-4 text-slate-400 font-medium"><%= index + 1 %></td>
                  <td class="px-6 py-4 font-bold text-slate-800"><%= seller.store_name || '-' %></td>
                  <td class="px-6 py-4 text-slate-700 font-medium">
                    <%= seller.name %>
                    <div class="text-xs text-slate-400 font-normal"><%= seller.email %></div>
                  </td>
                  <td class="px-6 py-4 text-slate-600"><%= seller.phone || '-' %></td>
                  <td class="px-6 py-4 font-semibold text-slate-700"><%= seller.total_products || 0 %> Produk</td>
                  <td class="px-6 py-4">
                    <span class="inline-flex items-center gap-1 rounded-full px-2.5 py-1 text-xs font-bold <%= seller.is_open ? 'bg-emerald-50 text-emerald-700' : 'bg-rose-50 text-rose-700' %>">
                      <span class="h-1.5 w-1.5 rounded-full <%= seller.is_open ? 'bg-emerald-500' : 'bg-rose-500' %>"></span>
                      <%= seller.is_open ? 'Buka' : 'Tutup' %>
                    </span>
                  </td>
                  <td class="px-6 py-4 text-right">
                    <div class="flex items-center justify-end gap-2">
                      <a
                        href="/admin/sellers/<%= seller.user_id %>/edit"
                        class="inline-flex items-center gap-1 rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-indigo-50 hover:text-indigo-600 transition"
                      >
                        <i data-lucide="pencil" class="h-3.5 w-3.5"></i>
                        <span>Edit</span>
                      </a>

                      <form
                        action="/admin/sellers/<%= seller.user_id %>?_method=DELETE"
                        method="POST"
                        onsubmit="return confirm('Apakah Anda yakin ingin menghapus seller ini? Semua toko & produknya akan ikut terhapus!')"
                        class="inline"
                      >
                        <button
                          type="submit"
                          class="inline-flex items-center gap-1 rounded-lg border border-rose-200 bg-rose-50 px-3 py-1.5 text-xs font-semibold text-rose-600 hover:bg-rose-100 transition"
                        >
                          <i data-lucide="trash-2" class="h-3.5 w-3.5"></i>
                          <span>Hapus</span>
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

  </main>

  <script>
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  </script>
</body>
</html>