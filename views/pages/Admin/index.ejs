<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Dashboard Admin' %></title>
  
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="bg-slate-50 font-sans antialiased flex flex-col min-h-screen">

  <main class="flex-grow mx-auto max-w-7xl w-full px-4 py-8 sm:px-6 lg:px-8">
    
    <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <p class="text-xs font-bold tracking-wider uppercase text-indigo-600">ADMIN CONTROL CENTER</p>
        <h1 class="mt-1 text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">
          Ringkasan Platform
        </h1>
        <p class="mt-1 text-sm text-slate-500">
          Pantau statistik transaksi, jumlah toko kantin, dan pengguna aktif.
        </p>
      </div>

      <a
        href="/admin/sellers"
        class="inline-flex items-center justify-center gap-2 rounded-xl bg-indigo-600 px-5 py-2.5 text-xs font-bold text-white shadow-md shadow-indigo-100 hover:bg-indigo-700 transition"
      >
        <i data-lucide="store" class="h-4 w-4"></i>
        Kelola Seller & Toko
      </a>
    </div>

    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      
      <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Total Transaksi Selesai</span>
          <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600">
            <i data-lucide="wallet" class="h-5 w-5"></i>
          </div>
        </div>
        <div class="mt-4 text-2xl font-black text-slate-900">
          Rp <%= Number(stats.totalOmset).toLocaleString('id-ID') %>
        </div>
        <p class="mt-1 text-xs text-slate-400">Dari <%= stats.totalOrders %> pesanan selesai</p>
      </div>

      <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Toko / Seller</span>
          <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-indigo-50 text-indigo-600">
            <i data-lucide="store" class="h-5 w-5"></i>
          </div>
        </div>
        <div class="mt-4 text-2xl font-black text-slate-900">
          <%= stats.totalSellers %> Toko
        </div>
        <p class="mt-1 text-xs text-slate-400">Penjual terdaftar</p>
      </div>

      <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Pembeli / Buyer</span>
          <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-50 text-blue-600">
            <i data-lucide="users" class="h-5 w-5"></i>
          </div>
        </div>
        <div class="mt-4 text-2xl font-black text-slate-900">
          <%= stats.totalBuyers %> Akun
        </div>
        <p class="mt-1 text-xs text-slate-400">Siswa / Pelanggan aktif</p>
      </div>

      <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Menu Produk</span>
          <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-amber-50 text-amber-600">
            <i data-lucide="utensils" class="h-5 w-5"></i>
          </div>
        </div>
        <div class="mt-4 text-2xl font-black text-slate-900">
          <%= stats.totalProducts %> Item
        </div>
        <p class="mt-1 text-xs text-slate-400">Total menu di platform</p>
      </div>

    </div>

    <div class="mt-8 rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden">
      <div class="border-b border-slate-100 p-5">
        <h3 class="font-bold text-slate-800 text-base">Pesanan Terbaru di Seluruh Toko</h3>
      </div>
      
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm text-slate-600">
          <thead>
            <tr class="border-b border-slate-100 bg-slate-50/70 text-xs font-bold uppercase tracking-wider text-slate-400">
              <th class="px-6 py-4">ID Pesanan</th>
              <th class="px-6 py-4">Toko</th>
              <th class="px-6 py-4">Pembeli</th>
              <th class="px-6 py-4">Total</th>
              <th class="px-6 py-4">Status</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% if (recentOrders.length === 0) { %>
              <tr>
                <td colspan="5" class="px-6 py-8 text-center text-xs text-slate-400">Belum ada pesanan terbaru.</td>
              </tr>
            <% } else { %>
              <% recentOrders.forEach(order => { %>
                <tr class="hover:bg-slate-50/50 transition">
                  <td class="px-6 py-4 font-mono font-bold text-slate-700">#<%= order.id %></td>
                  <td class="px-6 py-4 font-semibold text-slate-800"><%= order.store_name || '-' %></td>
                  <td class="px-6 py-4 text-slate-600"><%= order.buyer_name || 'Buyer' %></td>
                  <td class="px-6 py-4 font-bold text-slate-900">Rp <%= Number(order.total_price).toLocaleString('id-ID') %></td>
                  <td class="px-6 py-4">
                    <span class="inline-flex items-center rounded-md px-2.5 py-1 text-xs font-semibold capitalize 
                      <%= order.status === 'completed' ? 'bg-emerald-50 text-emerald-700' : (order.status === 'pending' ? 'bg-amber-50 text-amber-700' : 'bg-blue-50 text-blue-700') %>">
                      <%= order.status %>
                    </span>
                  </td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

  </main>

  <script>
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  </script>
</body>
</html>