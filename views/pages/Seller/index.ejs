<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Seller Dashboard' %></title>
  
  <!-- CDN Tailwind CSS & Lucide Icons -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="bg-slate-50 font-sans antialiased flex flex-col min-h-screen">

  <% 
    // Fallback variabel jika belum di-passing lengkap oleh controller
    var sellerData = (typeof seller !== 'undefined' && seller) ? seller : { 
      name: "Kantin Seller", 
      isOpen: true
    };
    var statsData = (typeof stats !== 'undefined' && stats) ? stats : {
      totalProducts: 0,
      newOrders: 0,
      totalRevenue: 0
    };
  %>

  <!-- MAIN CONTENT -->
  <main class="flex-grow mx-auto max-w-7xl w-full px-4 py-8 sm:px-6 lg:px-8">
    
    <!-- WELCOME CARD -->
    <div class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-8 shadow-sm">
      <div class="inline-flex items-center gap-2 rounded-xl bg-indigo-50 px-3 py-1.5 text-xs font-bold text-indigo-700 mb-3">
        <i data-lucide="shopping-bag" class="h-4 w-4"></i>
        SELLER DASHBOARD
      </div>

      <h1 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">
        Halo, <%= sellerData.name %> 👋
      </h1>

      <p class="mt-2 text-sm text-slate-500 max-w-xl">
        Kelola menu makanan, pantau stok, dan proses pesanan masuk dari pembeli secara praktis.
      </p>
    </div>

    <!-- STATISTIC CARDS -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-6 my-8">
  
  <!-- CARD 1: TOTAL PENDAPATAN -->
  <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
    <div>
      <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Total Pendapatan</p>
      <h3 class="text-2xl font-bold text-slate-900 mt-1">
        Rp <%= Number(stats.totalRevenue).toLocaleString('id-ID') %>
      </h3>
      <p class="text-[11px] text-indigo-600 font-medium mt-1">Dari pesanan selesai</p>
    </div>
    <div class="h-12 w-12 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center">
      <i data-lucide="wallet" class="h-6 w-6"></i>
    </div>
  </div>

  <!-- CARD 2: PESANAN BARU -->
  <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
    <div>
      <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Pesanan Baru</p>
      <h3 class="text-2xl font-bold text-slate-900 mt-1">
        <%= stats.newOrdersCount %> Pesanan
      </h3>
      <p class="text-[11px] text-amber-600 font-medium mt-1">Perlu segera diproses</p>
    </div>
    <div class="h-12 w-12 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center">
      <i data-lucide="shopping-bag" class="h-6 w-6"></i>
    </div>
  </div>

  <!-- CARD 3: TOTAL PRODUK AKTIF -->
  <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
    <div>
      <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Menu Aktif</p>
      <h3 class="text-2xl font-bold text-slate-900 mt-1">
        <%= stats.totalProducts %> Produk
      </h3>
      <p class="text-[11px] text-blue-600 font-medium mt-1">Tersedia di katalog</p>
    </div>
    <div class="h-12 w-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center">
      <i data-lucide="utensils" class="h-6 w-6"></i>
    </div>
  </div>

</div>

    <!-- MAIN NAVIGATION CARDS -->
    <div class="mt-6 grid gap-4 sm:grid-cols-2">
      <!-- Card Products -->
      <a
        href="/seller/products"
        class="group rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:border-indigo-500 hover:shadow-md hover:-translate-y-0.5"
      >
        <div class="flex items-center justify-between">
          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-indigo-50 text-indigo-600 group-hover:bg-indigo-600 group-hover:text-white transition">
            <i data-lucide="package" class="h-6 w-6"></i>
          </div>
          <i data-lucide="arrow-right" class="h-5 w-5 text-slate-300 group-hover:text-indigo-600 transition"></i>
        </div>

        <h2 class="mt-4 text-lg font-bold text-slate-900 group-hover:text-indigo-600 transition">
          Kelola Produk & Menu
        </h2>

        <p class="mt-1 text-xs text-slate-500 leading-relaxed">
          Tambah menu baru, atur harga, dan ubah ketersediaan stok produk kantin Anda.
        </p>
      </a>

      <!-- Card Orders -->
      <a
        href="/seller/orders"
        class="group rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:border-indigo-500 hover:shadow-md hover:-translate-y-0.5"
      >
        <div class="flex items-center justify-between">
          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-indigo-50 text-indigo-600 group-hover:bg-indigo-600 group-hover:text-white transition">
            <i data-lucide="folder-kanban" class="h-6 w-6"></i>
          </div>
          <i data-lucide="arrow-right" class="h-5 w-5 text-slate-300 group-hover:text-indigo-600 transition"></i>
        </div>

        <h2 class="mt-4 text-lg font-bold text-slate-900 group-hover:text-indigo-600 transition">
          Pesanan Masuk
        </h2>

        <p class="mt-1 text-xs text-slate-500 leading-relaxed">
          Pantau daftar pesanan pembeli, update status masak, dan proses pembayaran.
        </p>
      </a>
    </div>

  </main>

  <script>
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }

    let isStoreOpen = <%= sellerData.isOpen ? 'true' : 'false' %>;

    function toggleStoreStatus() {
      isStoreOpen = !isStoreOpen;
      const badge = document.getElementById('store-status-badge');
      const dot = document.getElementById('store-status-dot');
      const text = document.getElementById('store-status-text');

      if (isStoreOpen) {
        badge.className = 'inline-flex items-center gap-1.5 rounded-full bg-indigo-50 text-indigo-700 border border-indigo-200 px-3 py-1 text-xs font-bold';
        dot.className = 'h-2 w-2 rounded-full bg-indigo-500 animate-pulse';
        text.textContent = 'Toko Buka';
      } else {
        badge.className = 'inline-flex items-center gap-1.5 rounded-full bg-rose-50 text-rose-700 border border-rose-200 px-3 py-1 text-xs font-bold';
        dot.className = 'h-2 w-2 rounded-full bg-rose-500';
        text.textContent = 'Toko Tutup';
      }
    }
  </script>
</body>
</html>