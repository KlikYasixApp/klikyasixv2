<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= (typeof product !== 'undefined' && product && product.id) ? 'Edit Produk' : 'Tambah Produk' %> - Seller Center</title>
  
  <!-- CDN Tailwind CSS & Lucide Icons -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="bg-slate-50 font-sans antialiased flex flex-col min-h-screen">

  <% 
    // CEK STATUS EDIT / TAMBAH
    var isEdit = typeof product !== 'undefined' && product && product.id;
    var formData = isEdit ? product : {
      name: '',
      category: 'Makanan',
      price: '',
      stock: '',
      image: '',
      description: ''
    };
    var categories = ['Makanan', 'Minuman', 'Snack', 'Buah', 'Lainnya'];
  %>

  <!-- MAIN CONTENT CONTAINER -->
  <main class="flex-grow mx-auto max-w-2xl w-full px-4 py-8 sm:px-6 lg:px-8">
    
    <!-- BACK LINK -->
    <a
      href="/seller/products"
      class="inline-flex items-center gap-2 text-sm font-semibold text-slate-500 hover:text-indigo-600 transition"
    >
      <i data-lucide="arrow-left" class="h-4 w-4"></i>
      Kembali ke Daftar Produk
    </a>

    <!-- FORM CARD -->
    <div class="mt-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
      
      <!-- ICON HEADER -->
      <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-indigo-50 text-indigo-600">
        <i data-lucide="package" class="h-6 w-6"></i>
      </div>

      <h1 class="mt-5 text-2xl font-black text-slate-900 tracking-tight">
        <%= isEdit ? "Edit Produk" : "Tambah Produk" %>
      </h1>

      <p class="mt-2 text-sm text-slate-500">
        Masukkan informasi detail produk kantin Anda di bawah ini.
      </p>

      <!-- FORM -->
      <form 
        action="<%= isEdit ? ('/seller/products/' + formData.id + '?_method=PUT') : '/seller/products' %>" 
        method="POST" 
        id="product-form"
        onsubmit="return validateForm(event)"
        class="mt-8 space-y-5"
      >
        <!-- NAMA PRODUK -->
        <div>
          <label class="mb-2 block text-sm font-bold text-slate-700" for="name">
            Nama Produk <span class="text-rose-500">*</span>
          </label>
          <input
            id="name"
            name="name"
            type="text"
            value="<%= formData.name %>"
            placeholder="Contoh: Nasi Goreng Spesial"
            class="h-12 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 text-sm text-slate-800 outline-none transition focus:border-indigo-500 focus:bg-white focus:ring-2 focus:ring-indigo-100"
            required
          />
        </div>

        <!-- KATEGORI & HARGA GRID -->
        <div class="grid gap-5 sm:grid-cols-2">
          <!-- KATEGORI -->
          <div>
            <label class="mb-2 block text-sm font-bold text-slate-700" for="category">
              Kategori <span class="text-rose-500">*</span>
            </label>
            <select
              id="category"
              name="category"
              class="h-12 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 text-sm text-slate-800 outline-none transition focus:border-indigo-500 focus:bg-white focus:ring-2 focus:ring-indigo-100"
            >
              <% categories.forEach(function(cat) { %>
                <option value="<%= cat %>" <%= formData.category === cat ? 'selected' : '' %>>
                  <%= cat %>
                </option>
              <% }); %>
            </select>
          </div>

          <!-- HARGA -->
          <div>
            <label class="mb-2 block text-sm font-bold text-slate-700" for="price">
              Harga (Rp) <span class="text-rose-500">*</span>
            </label>
            <input
              id="price"
              name="price"
              type="number"
              min="0"
              value="<%= formData.price %>"
              placeholder="12000"
              class="h-12 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 text-sm text-slate-800 outline-none transition focus:border-indigo-500 focus:bg-white focus:ring-2 focus:ring-indigo-100"
              required
            />
          </div>
        </div>

        <!-- STOK -->
        <div>
          <label class="mb-2 block text-sm font-bold text-slate-700" for="stock">
            Stok Produk <span class="text-rose-500">*</span>
          </label>
          <input
            id="stock"
            name="stock"
            type="number"
            min="0"
            value="<%= formData.stock %>"
            placeholder="20"
            class="h-12 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 text-sm text-slate-800 outline-none transition focus:border-indigo-500 focus:bg-white focus:ring-2 focus:ring-indigo-100"
            required
          />
        </div>

        <!-- URL GAMBAR -->
        <div>
          <label class="mb-2 block text-sm font-bold text-slate-700" for="image">
            URL Gambar
          </label>
          <input
            id="image"
            name="image"
            type="url"
            value="<%= formData.image %>"
            placeholder="https://images.unsplash.com/..."
            class="h-12 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 text-sm text-slate-800 outline-none transition focus:border-indigo-500 focus:bg-white focus:ring-2 focus:ring-indigo-100"
          />
        </div>

        <!-- DESKRIPSI -->
        <div>
          <label class="mb-2 block text-sm font-bold text-slate-700" for="description">
            Deskripsi Produk
          </label>
          <textarea
            id="description"
            name="description"
            rows="4"
            placeholder="Jelaskan deskripsi rasa, porsi, atau komposisi produk..."
            class="w-full resize-none rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-800 outline-none transition focus:border-indigo-500 focus:bg-white focus:ring-2 focus:ring-indigo-100"
          ><%= formData.description %></textarea>
        </div>

        <!-- ERROR CONTAINER CLIENT-SIDE & SERVER-SIDE -->
        <div id="error-message" class="<%= (typeof error !== 'undefined' && error) ? '' : 'hidden' %> rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm font-semibold text-rose-600">
          <%= (typeof error !== 'undefined' && error) ? error : '' %>
        </div>

        <!-- SUBMIT BUTTON -->
        <button
          type="submit"
          id="submit-btn"
          class="flex h-12 w-full items-center justify-center gap-2 rounded-xl bg-indigo-600 font-bold text-white shadow-md shadow-indigo-100 hover:bg-indigo-700 active:scale-[0.99] transition disabled:opacity-50"
        >
          <i data-lucide="save" class="h-4 w-4"></i>
          <span id="btn-text"><%= isEdit ? "Simpan Perubahan" : "Tambah Produk" %></span>
        </button>
      </form>
    </div>
  </main>

  <!-- CLIENT-SIDE SCRIPT -->
  <script>
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }

    function validateForm(event) {
      const name = document.getElementById('name').value.trim();
      const price = document.getElementById('price').value;
      const stock = document.getElementById('stock').value;
      const errorDiv = document.getElementById('error-message');
      const submitBtn = document.getElementById('submit-btn');
      const btnText = document.getElementById('btn-text');

      errorDiv.classList.add('hidden');
      errorDiv.innerText = '';

      if (!name) {
        showError('Nama produk wajib diisi.');
        return false;
      }

      if (price === '' || Number(price) < 0) {
        showError('Harga produk tidak valid.');
        return false;
      }

      if (stock === '' || Number(stock) < 0) {
        showError('Stok produk tidak valid.');
        return false;
      }

      submitBtn.disabled = true;
      btnText.innerText = 'Menyimpan...';

      return true;
    }

    function showError(message) {
      const errorDiv = document.getElementById('error-message');
      errorDiv.innerText = message;
      errorDiv.classList.remove('hidden');
    }
  </script>
</body>
</html>