<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard - Kantin</title>
  
  <!-- CDN Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  
  <!-- CDN Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="bg-slate-50 font-sans antialiased">

  <% 
    // =========================================================================
    // MOCKUP DATA ADMIN & STATISTIK (Langsung di EJS)
    // =========================================================================
    var currentUser = (typeof user !== 'undefined' && user) ? user : {
      name: "Admin Kantin",
    };

    var stats = [
      {
        title: "Total Seller Aktif",
        value: "12",
        unit: "Kantin",
        subtext: "2 baru minggu ini",
        icon: "store",
        color: "text-blue-600",
        bgColor: "bg-blue-50"
      },
      {
        title: "Pesanan Hari Ini",
        value: "48",
        unit: "Pesanan",
        subtext: "12 sedang diproses",
        icon: "shopping-bag",
        color: "text-emerald-600",
        bgColor: "bg-emerald-50"
      },
      {
        title: "Omset Hari Ini",
        value: "Rp 650.000",
        unit: "",
        subtext: "+15% dibanding kemarin",
        icon: "wallet",
        color: "text-indigo-600",
        bgColor: "bg-indigo-50"
      },
      {
        title: "Verifikasi Seller",
        value: "3",
        unit: "Pending",
        subtext: "Butuh persetujuan",
        icon: "clock",
        color: "text-amber-600",
        bgColor: "bg-amber-50"
      }
    ];
  %>

  <main class="min-h-screen px-4 py-8 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl space-y-6">
      
      <!-- HERO WELCOME CARD -->
      <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
        <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <div class="flex items-center gap-2">
              <span class="inline-block rounded-md bg-blue-50 px-2.5 py-1 text-xs font-bold uppercase tracking-wide text-blue-600">
                Admin Dashboard
              </span>
            </div>
            <h1 class="mt-2 text-2xl font-black text-slate-900 sm:text-3xl">
              Halo, <%= currentUser.name %>
            </h1>
            <p class="mt-1 text-sm text-slate-500">
              Selamat datang di panel kontrol utama. Berikut ringkasan performa kantin hari ini.
            </p>
          </div>

          <!-- Tombol Aksi Utama -->
          <a
            href="/admin/sellers"
            class="inline-flex shrink-0 items-center justify-center gap-2 rounded-xl bg-blue-600 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-blue-600/20 transition hover:bg-blue-700 active:scale-[0.99]"
          >
            <i data-lucide="store" class="h-4.5 w-4.5"></i>
            <span>Kelola Seller</span>
            <i data-lucide="arrow-right" class="h-4 w-4"></i>
          </a>
        </div>
      </div>

      <!-- GRID STAT CARDS -->
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <% stats.forEach(function(item) { %>
          <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-slate-300">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold uppercase tracking-wider text-slate-400">
                <%= item.title %>
              </span>
              <div class="flex h-10 w-10 items-center justify-center rounded-xl <%= item.bgColor %> <%= item.color %>">
                <i data-lucide="<%= item.icon %>" class="h-5 w-5"></i>
              </div>
            </div>

            <div class="mt-3 flex items-baseline gap-1.5">
              <span class="text-2xl font-black text-slate-900"><%= item.value %></span>
              <% if(item.unit) { %>
                <span class="text-xs font-semibold text-slate-500"><%= item.unit %></span>
              <% } %>
            </div>

            <p class="mt-2 text-xs font-medium text-slate-500">
              <%= item.subtext %>
            </p>
          </div>
        <% }); %>
      </div>

    </div>
  </main>

  <%- include('../../partials/footer') %>

  <!-- Script Render Lucide Icons -->
  <script>
    lucide.createIcons();
  </script>
</body>
</html>