<%- include('../../partials/header') %>

<% 
  // MOCK DATA LANGSUNG UNTUK TES UI
  const items = [
    {
      id: '1',

      quantity: 2,
      image: 'https://images.unsplash.com/photo-1603133872878-684f208fb84b?w=300'
    },
    {
      id: '2',
      name: 'Es Teh Manis',
      price: 5000,
      quantity: 2,
      image: 'https://images.unsplash.com/photo-1556679343-c7306c1976bc?w=300'
    }
  ];

  const totalItems = items.reduce((total, item) => total + Number(item.quantity || 0), 0);
  const subtotal = items.reduce((total, item) => total + (Number(item.price || 0) * Number(item.quantity || 0)), 0);
  const formatPrice = (val) => 'Rp ' + Number(val).toLocaleString('id-ID');
%>

<div class="min-h-screen bg-slate-50">
  <section class="border-b border-slate-200 bg-white">
    <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
      <a
        href="/cart"
        class="inline-flex items-center gap-2 text-sm font-semibold text-slate-500 transition hover:text-blue-600"
      >
        <i data-lucide="arrow-left" class="h-4 w-4"></i>
        Kembali ke keranjang
      </a>

      <h1 class="mt-6 text-3xl font-black tracking-tight text-slate-900">
        Checkout
      </h1>

      <p class="mt-2 text-sm text-slate-500">
        Lengkapi informasi untuk memproses pesananmu.
      </p>
    </div>
  </section>

  <main class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <form
      onsubmit="return false;"
      class="grid gap-6 lg:grid-cols-[1fr_380px] lg:items-start"
    >
      <div class="space-y-6">
        <!-- INFORMASI PEMESAN -->
        <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
          <div class="flex items-center gap-3">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-50 text-blue-600">
              <i data-lucide="user" class="h-5 w-5"></i>
            </div>

            <div>
              <h2 class="font-black text-slate-900">
                Informasi Pemesan
              </h2>

              <p class="text-xs text-slate-500">
                Informasi untuk pengambilan pesanan.
              </p>
            </div>
          </div>

          <div class="mt-6 grid gap-5 sm:grid-cols-2">
            <div>
              <label
                for="name"
                class="mb-2 block text-sm font-semibold text-slate-700"
              >
                Nama
              </label>

              <input
                id="name"
                name="name"
                type="text"
                placeholder="Masukkan nama"
                value="Muhammad Kholil"
                class="h-12 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 text-sm outline-none transition placeholder:text-slate-400 focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-500/10"
              />
            </div>

            <div>
              <label
                for="className"
                class="mb-2 block text-sm font-semibold text-slate-700"
              >
                Kelas
              </label>

              <input
                id="className"
                name="className"
                type="text"
                placeholder="Contoh: XI RPL 1"
                value="X TJKT 3"
                class="h-12 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 text-sm outline-none transition placeholder:text-slate-400 focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-500/10"
              />
            </div>
          </div>
        </section>

        <!-- WAKTU PENGAMBILAN -->
        <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
          <div class="flex items-center gap-3">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-50 text-blue-600">
              <i data-lucide="clock-3" class="h-5 w-5"></i>
            </div>

            <div>
              <h2 class="font-black text-slate-900">
                Waktu Pengambilan
              </h2>

              <p class="text-xs text-slate-500">
                Pilih perkiraan waktu mengambil pesanan.
              </p>
            </div>
          </div>

          <div class="mt-6">
            <label
              for="pickupTime"
              class="mb-2 block text-sm font-semibold text-slate-700"
            >
              Waktu
            </label>

            <select
              id="pickupTime"
              name="pickupTime"
              class="h-12 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 text-sm text-slate-700 outline-none transition focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-500/10"
            >
              <option value="">Pilih waktu pengambilan</option>
              <option value="09:00 - 09:30" selected>09:00 - 09:30</option>
              <option value="09:30 - 10:00">09:30 - 10:00</option>
              <option value="10:00 - 10:30">10:00 - 10:30</option>
              <option value="10:30 - 11:00">10:30 - 11:00</option>
              <option value="11:00 - 11:30">11:00 - 11:30</option>
              <option value="11:30 - 12:00">11:30 - 12:00</option>
              <option value="12:00 - 12:30">12:00 - 12:30</option>
            </select>
          </div>
        </section>

        <!-- CATATAN -->
        <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
          <div class="flex items-center gap-3">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-50 text-blue-600">
              <i data-lucide="file-text" class="h-5 w-5"></i>
            </div>

            <div>
              <h2 class="font-black text-slate-900">Catatan</h2>

              <p class="text-xs text-slate-500">
                Tambahkan catatan jika diperlukan.
              </p>
            </div>
          </div>

          <textarea
            name="note"
            rows="4"
            placeholder="Contoh: Jangan terlalu pedas..."
            class="mt-6 w-full resize-none rounded-xl border border-slate-200 bg-slate-50 p-4 text-sm outline-none transition placeholder:text-slate-400 focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-500/10"
          >Jangan terlalu pedas ya, terima kasih.</textarea>
        </section>
      </div>

      <!-- RINGKASAN PESANAN -->
      <aside class="lg:sticky lg:top-24">
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
          <h2 class="text-lg font-black text-slate-900">
            Ringkasan Pesanan
          </h2>

          <div class="mt-5 space-y-4">
            <% items.forEach((item) => { %>
              <div class="flex gap-3">
                <% if (item.image) { %>
                  <img
                    src="<%= item.image %>"
                    alt="<%= item.name %>"
                    class="h-14 w-14 rounded-xl object-cover shrink-0"
                  />
                <% } else { %>
                  <div class="h-14 w-14 rounded-xl bg-slate-100 shrink-0"></div>
                <% } %>

                <div class="min-w-0 flex-1">
                  <p class="line-clamp-1 text-sm font-bold text-slate-900">
                    <%= item.name %>
                  </p>

                  <p class="mt-1 text-xs text-slate-500">
                    <%= item.quantity %> × <%= formatPrice(item.price) %>
                  </p>
                </div>

                <p class="text-sm font-bold text-slate-900">
                  <%= formatPrice(item.price * item.quantity) %>
                </p>
              </div>
            <% }); %>
          </div>

          <div class="my-5 h-px bg-slate-200"></div>

          <div class="flex items-center justify-between text-sm">
            <span class="text-slate-500">Total item</span>

            <span class="font-semibold text-slate-900">
              <%= totalItems %>
            </span>
          </div>

          <div class="mt-3 flex items-center justify-between">
            <span class="font-bold text-slate-900">Total</span>

            <span class="text-xl font-black text-blue-600">
              <%= formatPrice(subtotal) %>
            </span>
          </div>

          <div class="mt-5 rounded-xl bg-blue-50 p-4">
            <p class="text-xs leading-5 text-blue-700">
              Pembayaran dilakukan langsung sesuai ketentuan kantin. Tidak
              ada payment gateway pada tahap ini.
            </p>
          </div>

          <button
            type="submit"
            class="mt-5 flex w-full items-center justify-center gap-2 rounded-xl bg-blue-600 px-5 py-3.5 font-bold text-white shadow-lg shadow-blue-600/20 transition hover:bg-blue-700 cursor-pointer"
          >
            <i data-lucide="check-circle-2" class="h-5 w-5"></i>
            <span>Konfirmasi Pesanan</span>
          </button>
        </div>
      </aside>
    </form>
  </main>
</div>

<%- include('../../partials/footer') %>