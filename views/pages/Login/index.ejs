<!DOCTYPE html>
<html lang="id" class="fixed inset-0 overflow-hidden">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title : 'Login - Klik Yasix' %></title>
  
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
</head>
<body class="bg-slate-50 text-slate-900 m-0 p-0 fixed inset-0 overflow-hidden">

  <div class="w-full h-full p-2.5 sm:p-4 box-border bg-slate-200/60 flex items-center justify-center">
    <div class="w-full h-full rounded-t-xl overflow-hidden shadow-[0_20px_60px_-15px_rgba(0,0,0,0.15)] border border-slate-300 relative">
      <div class="flex w-full h-full">
        <div class="hidden lg:flex relative w-2/3 h-full bg-slate-900">
          <img 
            src="/gedung.png" 
            alt="Gedung Yasix" 
            class="absolute inset-0 w-full h-full object-cover opacity-90 mix-blend-luminosity"
          />
          <div class="absolute inset-0 bg-slate-900/40"></div>
        </div>

        <div class="hidden lg:block relative z-20 w-1.5 h-full bg-blue-500 shadow-[0_0_20px_rgba(59,130,246,0.6)]"></div>

        <div class="relative flex w-full lg:w-1/2 h-full items-center justify-center p-4 sm:p-6 bg-[#F8FAFC]">
          <div class="absolute top-0 right-0 -mt-20 -mr-20 h-96 w-96 rounded-full bg-blue-400/10 blur-3xl pointer-events-none"></div>
          <div class="absolute bottom-0 left-0 -mb-20 -ml-20 h-80 w-80 rounded-full bg-blue-600/5 blur-3xl pointer-events-none"></div>

          <div class="relative z-10 w-full max-w-sm rounded-3xl border border-slate-100 bg-white/90 p-5 sm:p-6 shadow-[0_20px_60px_-15px_rgba(0,0,0,0.05)] backdrop-blur-xl">
            <div class="absolute left-1/2 top-0 h-1 w-24 -translate-x-1/2 rounded-b-full bg-blue-500"></div>

            <div class="mb-5 text-center">
              <a href="/" class="group inline-flex items-center gap-3 transition-transform hover:scale-105">
                <div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-blue-600 text-white shadow-md border border-blue-500">
                  <img
                    class="h-7 w-7 drop-shadow-sm"
                    src="/yadika.png"
                    alt="Logo Klik Yasix"
                  />
                </div>
                <div class="text-left">
                  <p class="text-xl font-black tracking-tight text-slate-900 leading-none">
                    Klik <span class="text-blue-600">Yasix</span>
                  </p>
                  <p class="mt-1 text-[10px] font-semibold tracking-widest text-slate-400 uppercase">
                    Kantin Digital
                  </p>
                </div>
              </a>

              <h1 class="mt-4 text-xl sm:text-2xl font-black tracking-tight text-slate-900">
                Selamat Datang
              </h1>
              <p class="mt-0.5 text-xs text-slate-500 font-medium">
                Silakan masuk dengan akun Anda.
              </p>
            </div>

            <form action="/login" method="POST" class="space-y-3.5">
              <div class="group">
                <label for="email" class="mb-1 block text-xs font-bold text-slate-700">
                  Alamat Email
                </label>
                <div class="relative">
                  <i data-lucide="mail" class="absolute left-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400 transition-colors group-focus-within:text-blue-600"></i>
                  <input
                    id="email"
                    name="email"
                    type="email"
                    required
                    autocomplete="username"
                    placeholder="nama@email.com"
                    value="<%= typeof email !== 'undefined' ? email : '' %>"
                    class="h-11 w-full rounded-xl border border-slate-200 bg-slate-50/50 pl-10 pr-4 text-xs font-medium text-slate-900 outline-none transition-all focus:border-blue-500 focus:bg-white focus:ring-2 focus:ring-blue-500/20"
                  />
                </div>
              </div>

              <div class="group">
                <label for="password" class="mb-1 flex justify-between text-xs font-bold text-slate-700">
                  <span>Kata Sandi</span>
                </label>
                <div class="relative">
                  <i data-lucide="lock" class="absolute left-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400 transition-colors group-focus-within:text-blue-600"></i>
                  <input
                    id="password"
                    name="password"
                    type="password"
                    required
                    autocomplete="current-password"
                    placeholder="Masukkan kata sandi"
                    class="h-11 w-full rounded-xl border border-slate-200 bg-slate-50/50 pl-10 pr-4 text-xs font-medium text-slate-900 outline-none transition-all focus:border-blue-500 focus:bg-white focus:ring-2 focus:ring-blue-500/20"
                  />
                </div>
              </div>

              <% if (typeof error !== 'undefined' && error) { %>
                <div class="rounded-xl border border-red-200 bg-red-50 p-2.5 text-xs font-semibold text-red-600 flex items-center gap-2">
                  <i data-lucide="alert-circle" class="h-4 w-4 shrink-0"></i>
                  <span><%= error %></span>
                </div>
              <% } %>

              <button
                type="submit"
                class="group mt-4 flex h-11 w-full cursor-pointer items-center justify-center gap-2 rounded-xl bg-blue-600 px-6 text-xs font-bold tracking-wide text-white transition-all hover:bg-blue-700 hover:shadow-[0_4px_12px_rgba(37,99,235,0.3)]"
              >
                <span>Masuk Sekarang</span>
                <i data-lucide="arrow-right" class="h-4 w-4 transition-transform group-hover:translate-x-1 text-blue-200"></i>
              </button>
            </form>

            <div class="mt-4 rounded-xl border border-blue-100 bg-blue-50/50 p-3 text-[11px] text-slate-600">
              <p class="font-black uppercase tracking-wider text-blue-700 mb-1.5 flex items-center gap-1.5">
                <i data-lucide="info" class="h-3.5 w-3.5"></i> Info Akses Demo
              </p>
              <div class="space-y-1 font-medium">
                <p class="flex justify-between border-b border-blue-200/50 pb-0.5">
                  <span>Admin:</span> <span class="font-bold text-slate-900">admin@kantin.local / admin123</span>
                </p>
                <p class="flex justify-between border-b border-blue-200/50 pb-0.5">
                  <span>Seller:</span> <span class="font-bold text-slate-900">seller@kantin.local / seller123</span>
                </p>
                <p class="flex justify-between">
                  <span>Buyer:</span> <span class="font-bold text-slate-900">buyer@kantin.local / buyer123</span>
                </p>
              </div>
            </div>

          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  </script>
</body>
</html>