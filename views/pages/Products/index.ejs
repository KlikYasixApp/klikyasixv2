<% 
  var title = typeof title !== 'undefined' ? title : "Menu Kantin - Semua Menu"; 
  var page = "menu"; 
  const productList = typeof products !== 'undefined' ? products : [];
  const searchQuery = typeof search !== 'undefined' ? search : "";
%>

<main class="min-h-screen bg-slate-50">
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <!-- Title Header -->
    <div>
      <p class="text-sm font-bold text-blue-600">MENU KANTIN</p>
      <h1 class="mt-1 text-3xl font-black text-slate-900">Semua Menu</h1>
    </div>

    <!-- Search & Filter Section -->
    <form action="/products" method="GET" class="mt-6 grid gap-3 md:grid-cols-[1fr_auto]">
      <!-- Input Search -->
      <div class="relative">
        <i
          data-lucide="search"
          class="absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-slate-400"
        ></i>
        <input
          type="text"
          name="search"
          value="<%= searchQuery %>"
          placeholder="Cari makanan atau toko..."
          class="h-12 w-full rounded-xl border border-slate-200 bg-white pl-11 pr-4 text-sm outline-none transition focus:border-blue-500"
        />
      </div>

      <!-- Select Category (Optional Filter) -->
      <select
        name="category"
        onchange="this.form.submit()"
        class="h-12 rounded-xl border border-slate-200 bg-white px-4 text-sm font-semibold outline-none transition focus:border-blue-500"
      >
        <option value="all">Semua Kategori</option>
        <option value="Makanan">Makanan</option>
        <option value="Minuman">Minuman</option>
        <option value="Cemilan">Cemilan</option>
      </select>
    </form>

    <!-- Product Grid -->
    <% if (productList.length > 0) { %>
      <div class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
        <% productList.forEach((product) => { %>
          <% const isAvailable = product.stock > 0; %>
          
          <div class="group block overflow-hidden rounded-2xl border border-slate-200 bg-white transition duration-300 hover:-translate-y-1 hover:border-blue-200 hover:shadow-xl">
            <!-- Product Image / Banner -->
            <a href="/products/<%= product.id %>" class="relative block h-52 overflow-hidden bg-slate-100">
              <% if (product.image) { %>
                <img
                  src="<%= imageUrl(product.image) || '/yadika.png' %>"
                  alt="<%= product.name %>"
                  loading="lazy"
                  class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
                />
              <% } else { %>
                <!-- Fallback Gambar Menggunakan Icon Package -->
                <div class="flex h-full w-full items-center justify-center bg-slate-100">
                  <i data-lucide="package" class="h-10 w-10 text-slate-300"></i>
                </div>
              <% } %>

              <!-- Store Badge -->
              <div class="absolute left-3 top-3 rounded-full bg-white/90 px-3 py-1 text-xs font-semibold text-slate-700 shadow-sm backdrop-blur-xs">
                <%= product.store_name %>
              </div>

              <!-- Overlay Tidak Tersedia / Stok Habis -->
              <% if (!isAvailable) { %>
                <div class="absolute inset-0 flex items-center justify-center bg-slate-900/50">
                  <span class="rounded-full bg-white px-4 py-2 text-sm font-bold text-slate-700 shadow-sm">
                    Stok habis
                  </span>
                </div>
              <% } %>
            </a>

            <!-- Content Card -->
            <div class="p-4">
              <p class="text-xs font-semibold text-blue-600">
                <%= product.category || 'Menu' %>
              </p>
              
              <a href="/products/<%= product.id %>">
                <h3 class="mt-1 line-clamp-1 font-bold text-slate-900 transition hover:text-blue-600">
                  <%= product.name %>
                </h3>
              </a>

              <p class="mt-1 line-clamp-2 text-xs text-slate-500">
                <%= product.description || 'Tidak ada deskripsi.' %>
              </p>

              <div class="mt-4 flex items-center justify-between gap-3">
                <div>
                  <p class="font-bold text-slate-900">
                    Rp <%= Number(product.price).toLocaleString('id-ID') %>
                  </p>
                  <p class="mt-1 text-xs <%= isAvailable ? 'text-slate-400' : 'text-red-500 font-medium' %>">
                    <%= isAvailable ? `Stok ${product.stock}` : 'Stok habis' %>
                  </p>
                </div>

                <!-- Form Add to Cart -->
                <% if (isAvailable) { %>
                  <form action="/carts" method="POST">
                    <input type="hidden" name="product_id" value="<%= product.id %>" />
                    <input type="hidden" name="quantity" value="1" />
                    <button
                      type="submit"
                      aria-label="Tambah <%= product.name %> ke keranjang"
                      class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-blue-50 text-blue-600 transition hover:bg-blue-600 hover:text-white"
                    >
                      <i data-lucide="shopping-bag" class="h-4 w-4"></i>
                    </button>
                  </form>
                <% } else { %>
                  <button
                    type="button"
                    disabled
                    aria-label="Stok <%= product.name %> habis"
                    class="flex h-10 w-10 shrink-0 cursor-not-allowed items-center justify-center rounded-xl bg-slate-100 text-slate-300"
                  >
                    <i data-lucide="shopping-bag" class="h-4 w-4"></i>
                  </button>
                <% } %>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <!-- STATE PRODUK KOSONG -->
      <div class="my-16 text-center">
        <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-slate-100 text-slate-400">
          <i data-lucide="search-x" class="h-8 w-8"></i>
        </div>
        <h3 class="mt-4 font-bold text-slate-900">Menu Tidak Ditemukan</h3>
        <p class="mt-1 text-xs text-slate-500">
          <%= searchQuery ? `Tidak ada hasil pencarian untuk "${searchQuery}"` : 'Belum ada menu yang tersedia saat ini.' %>
        </p>
      </div>
    <% } %>
  </div>
</main>

<script>
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }
</script>