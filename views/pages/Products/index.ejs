<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <!-- Script UMD Lucide Icon -->
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
    <title>Menu Kantin - Semua Menu</title>
  </head>
  <body class="flex min-h-screen flex-col bg-slate-50 text-slate-900">
    <!-- Sticky Glassmorphism Header -->
    <header
      class="sticky top-0 z-50 border-b border-slate-200 bg-white/50 backdrop-blur"
    >
      <div
        class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8"
      >
        <!-- Brand / Logo -->
        <a href="/" class="flex items-center gap-2.5">
          <div
            class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-600 text-white shadow-sm"
          >
            <img
              class="h-5 w-5"
              src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRJQmAp7KEiMrucNuFSDniURFfDCX6mbGlpSnqonfj501EbVNb1o_lF_JhE&s=10"
              alt="Logo"
            />
          </div>
          <span
            class="flex flex-col text-lg font-bold leading-none text-slate-900"
          >
            Klik
            <span class="text-xs font-bold leading-none text-blue-600"
              >Yasix</span
            >
          </span>
        </a>

        <!-- Navigation Links (Desktop) -->
        <nav
          class="hidden items-center gap-8 text-sm font-medium text-slate-600 md:flex"
        >
          <a
            href="/"
            class="rounded-2xl px-2 py-0.5 transition-colors hover:text-blue-600"
            >Beranda</a
          >
          <a
            href="/products"
            class="rounded-2xl px-2 py-0.5 font-semibold text-blue-600 transition-colors"
            >Menu</a
          >
          <a
            href="/orders"
            class="rounded-2xl px-2 py-0.5 transition-colors hover:text-blue-600"
            >Pesanan</a
          >
        </nav>

        <!-- CTA Buttons (Desktop) -->
        <div class="hidden items-center gap-4 md:flex">
          <a
            href="/login"
            class="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-indigo-500"
          >
            Log in
          </a>
        </div>

        <!-- Mobile Menu Toggle Button -->
        <button
          type="button"
          class="rounded-md p-2 text-slate-600 hover:bg-slate-100 md:hidden"
          aria-label="Toggle Menu"
        >
          <svg
            class="h-6 w-6"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"
            />
          </svg>
        </button>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-1">
      <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
        <!-- Title Header -->
        <div>
          <p class="text-sm font-bold text-blue-600">MENU KANTIN</p>
          <h1 class="mt-1 text-3xl font-black text-slate-900">Semua Menu</h1>
        </div>

        <!-- Search & Filter Section -->
        <div class="mt-6 grid gap-3 md:grid-cols-[1fr_auto]">
          <!-- Input Search -->
          <div class="relative">
            <i
              data-lucide="search"
              class="absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-slate-400"
            ></i>
            <input
              type="text"
              placeholder="Cari makanan..."
              class="h-12 w-full rounded-xl border border-slate-200 bg-white pl-11 pr-4 text-sm outline-none transition focus:border-blue-500"
            />
          </div>

          <!-- Select Category -->
          <select
            class="h-12 rounded-xl border border-slate-200 bg-white px-4 text-sm font-semibold outline-none transition focus:border-blue-500"
          >
            <option value="all">Semua Kategori</option>
            <option value="Makanan">Makanan</option>
            <option value="Minuman">Minuman</option>
            <option value="Cemilan">Cemilan</option>
          </select>
        </div>

        <!-- Product Grid -->
        <div class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
          <!-- PRODUCT CARD 1 (Tersedia) -->
          <a
            href="/products/1"
            class="group block overflow-hidden rounded-2xl border border-slate-200 bg-white transition duration-300 hover:-translate-y-1 hover:border-blue-200 hover:shadow-xl"
          >
            <div class="relative h-52 overflow-hidden bg-slate-100">
              <img
                src="https://images.unsplash.com/photo-1603133872878-684f208fb84b?auto=format&fit=crop&w=600&q=80"
                alt="Nasi Goreng Spesial"
                loading="lazy"
                class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
              />
              <div
                class="absolute left-3 top-3 rounded-full bg-white px-3 py-1 text-xs font-semibold text-slate-700 shadow-sm"
              >
                Makanan
              </div>
            </div>

            <div class="p-4">
              <p class="text-xs font-semibold text-blue-600">Makanan</p>
              <h3 class="mt-1 line-clamp-1 font-bold text-slate-900">
                Nasi Goreng Spesial
              </h3>
              <p class="mt-1 line-clamp-2 text-xs text-slate-500">
                Nasi goreng telur dengan suwiran ayam, sosis, dan kerupuk
                renyah.
              </p>

              <div class="mt-4 flex items-center justify-between gap-3">
                <div>
                  <p class="font-bold text-slate-900">Rp 15.000</p>
                  <p class="mt-1 text-xs text-slate-400">Stok 12</p>
                </div>

                <button
                  type="button"
                  aria-label="Tambah Nasi Goreng Spesial ke keranjang"
                  class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-blue-50 text-blue-600 transition hover:bg-blue-600 hover:text-white"
                >
                  <i data-lucide="shopping-bag" class="h-4 w-4"></i>
                </button>
              </div>
            </div>
          </a>

          <!-- PRODUCT CARD 2 (Tersedia) -->
          <a
            href="/products/2"
            class="group block overflow-hidden rounded-2xl border border-slate-200 bg-white transition duration-300 hover:-translate-y-1 hover:border-blue-200 hover:shadow-xl"
          >
            <div class="relative h-52 overflow-hidden bg-slate-100">
              <img
                src="https://images.unsplash.com/photo-1556679343-c7306c1976bc?auto=format&fit=crop&w=600&q=80"
                alt="Es Teh Manis Jumbo"
                loading="lazy"
                class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
              />
              <div
                class="absolute left-3 top-3 rounded-full bg-white px-3 py-1 text-xs font-semibold text-slate-700 shadow-sm"
              >
                Minuman
              </div>
            </div>

            <div class="p-4">
              <p class="text-xs font-semibold text-blue-600">Minuman</p>
              <h3 class="mt-1 line-clamp-1 font-bold text-slate-900">
                Es Teh Manis Jumbo
              </h3>
              <p class="mt-1 line-clamp-2 text-xs text-slate-500">
                Teh manis segar porsi jumbo penyegar dahaga di siang hari.
              </p>

              <div class="mt-4 flex items-center justify-between gap-3">
                <div>
                  <p class="font-bold text-slate-900">Rp 5.000</p>
                  <p class="mt-1 text-xs text-slate-400">Stok 30</p>
                </div>

                <button
                  type="button"
                  aria-label="Tambah Es Teh Manis Jumbo ke keranjang"
                  class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-blue-50 text-blue-600 transition hover:bg-blue-600 hover:text-white"
                >
                  <i data-lucide="shopping-bag" class="h-4 w-4"></i>
                </button>
              </div>
            </div>
          </a>

          <!-- PRODUCT CARD 3 (Stok Habis / Tidak Tersedia) -->
          <a
            href="/products/3"
            class="group block overflow-hidden rounded-2xl border border-slate-200 bg-white transition duration-300 hover:-translate-y-1 hover:border-blue-200 hover:shadow-xl"
          >
            <div class="relative h-52 overflow-hidden bg-slate-100">
              <img
                src="https://images.unsplash.com/photo-1626082927389-6cd097cdc6ec?auto=format&fit=crop&w=600&q=80"
                alt="Ayam Geprek Sambal Korek"
                loading="lazy"
                class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
              />
              <div
                class="absolute left-3 top-3 rounded-full bg-white px-3 py-1 text-xs font-semibold text-slate-700 shadow-sm"
              >
                Makanan
              </div>

              <!-- Overlay Tidak Tersedia -->
              <div
                class="absolute inset-0 flex items-center justify-center bg-slate-900/50"
              >
                <span
                  class="rounded-full bg-white px-4 py-2 text-sm font-bold text-slate-700 shadow-sm"
                >
                  Stok habis
                </span>
              </div>
            </div>

            <div class="p-4">
              <p class="text-xs font-semibold text-blue-600">Makanan</p>
              <h3 class="mt-1 line-clamp-1 font-bold text-slate-900">
                Ayam Geprek Sambal Korek
              </h3>
              <p class="mt-1 line-clamp-2 text-xs text-slate-500">
                Ayam crispy gurih digeprek dengan sambal korek pedas mantap.
              </p>

              <div class="mt-4 flex items-center justify-between gap-3">
                <div>
                  <p class="font-bold text-slate-900">Rp 18.000</p>
                  <p class="mt-1 text-xs text-slate-400">Stok habis</p>
                </div>

                <button
                  type="button"
                  disabled
                  aria-label="Tambah Ayam Geprek Sambal Korek ke keranjang"
                  class="flex h-10 w-10 shrink-0 cursor-not-allowed items-center justify-center rounded-xl bg-slate-100 text-slate-300 transition"
                >
                  <i data-lucide="shopping-bag" class="h-4 w-4"></i>
                </button>
              </div>
            </div>
          </a>

          <!-- PRODUCT CARD 4 (Fallback Gambar Kosong) -->
          <a
            href="/products/4"
            class="group block overflow-hidden rounded-2xl border border-slate-200 bg-white transition duration-300 hover:-translate-y-1 hover:border-blue-200 hover:shadow-xl"
          >
            <!-- Fallback Gambar Menggunakan Icon Package -->
            <div
              class="relative flex h-52 items-center justify-center bg-slate-100"
            >
              <i data-lucide="package" class="h-10 w-10 text-slate-300"></i>
              <div
                class="absolute left-3 top-3 rounded-full bg-white px-3 py-1 text-xs font-semibold text-slate-700 shadow-sm"
              >
                Cemilan
              </div>
            </div>

            <div class="p-4">
              <p class="text-xs font-semibold text-blue-600">Cemilan</p>
              <h3 class="mt-1 line-clamp-1 font-bold text-slate-900">
                Bakso Goreng Crispy
              </h3>
              <p class="mt-1 line-clamp-2 text-xs text-slate-500">
                Bakso goreng renyah dengan bumbu tabur balado gurih.
              </p>

              <div class="mt-4 flex items-center justify-between gap-3">
                <div>
                  <p class="font-bold text-slate-900">Rp 10.000</p>
                  <p class="mt-1 text-xs text-slate-400">Stok 8</p>
                </div>

                <button
                  type="button"
                  aria-label="Tambah Bakso Goreng Crispy ke keranjang"
                  class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-blue-50 text-blue-600 transition hover:bg-blue-600 hover:text-white"
                >
                  <i data-lucide="shopping-bag" class="h-4 w-4"></i>
                </button>
              </div>
            </div>
          </a>
        </div>
      </div>
    </main>

    <!-- Footer -->
    <footer class="border-t border-slate-200 bg-white py-6">
      <div
        class="mx-auto max-w-7xl px-4 text-center text-sm text-slate-500 sm:px-6 lg:px-8"
      >
        &copy; 2026 BrandName, Inc. All rights reserved.
      </div>
    </footer>

    <!-- Inisialisasi Lucide Icon -->
    <script>
      lucide.createIcons();
    </script>
  </body>
</html>
