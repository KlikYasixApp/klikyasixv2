<% var title = "Keranjang Belanja - Kantin"; var page = "cart"; %>
<%- include('../../partials/header') %>
      <div class="grid gap-6 lg:grid-cols-[1fr_380px] lg:items-start">
        <!-- DAFTAR ITEM KERANJANG -->
        <div class="space-y-4">
          <!-- ITEM 1 -->
          <div
            class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-5"
          >
            <div class="flex gap-4">
              <!-- Gambar Produk -->
              <a
                href="/products/1"
                class="shrink-0 overflow-hidden rounded-xl bg-slate-100"
              >
                <img
                  src="https://images.unsplash.com/photo-1603133872878-684f208fb84b?auto=format&fit=crop&w=600&q=80"
                  alt="Nasi Goreng Spesial"
                  class="h-24 w-24 object-cover transition hover:scale-105 sm:h-28 sm:w-28"
                />
              </a>

              <!-- Detail Produk -->
              <div class="min-w-0 flex-1">
                <div class="flex items-start justify-between gap-3">
                  <div>
                    <p class="text-xs font-semibold text-blue-600">Makanan</p>
                    <a
                      href="/products/1"
                      class="mt-1 block font-bold text-slate-900 hover:text-blue-600"
                    >
                      Nasi Goreng Spesial
                    </a>
                  </div>

                  <!-- Tombol Hapus -->
                  <button
                    type="button"
                    class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl text-slate-400 transition hover:bg-red-50 hover:text-red-500"
                    aria-label="Hapus item"
                  >
                    <i data-lucide="trash-2" class="h-4 w-4"></i>
                  </button>
                </div>

                <div
                  class="mt-5 flex flex-wrap items-center justify-between gap-3"
                >
                  <!-- Control Quantity -->
                  <div
                    class="flex items-center rounded-xl border border-slate-200"
                  >
                    <button
                      type="button"
                      class="flex h-9 w-9 items-center justify-center text-slate-500 transition hover:bg-slate-50 hover:text-slate-900"
                    >
                      <i data-lucide="minus" class="h-3.5 w-3.5"></i>
                    </button>

                    <span
                      class="w-9 text-center text-sm font-bold text-slate-900"
                    >
                      2
                    </span>

                    <button
                      type="button"
                      class="flex h-9 w-9 items-center justify-center text-slate-500 transition hover:bg-slate-50 hover:text-slate-900"
                    >
                      <i data-lucide="plus" class="h-3.5 w-3.5"></i>
                    </button>
                  </div>

                  <!-- Harga -->
                  <div class="text-right">
                    <p class="text-xs text-slate-400">Rp 15.000 × 2</p>
                    <p class="mt-0.5 font-black text-slate-900">Rp 30.000</p>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- ITEM 2 -->
          <div
            class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-5"
          >
            <div class="flex gap-4">
              <!-- Gambar Produk -->
              <a
                href="/products/2"
                class="shrink-0 overflow-hidden rounded-xl bg-slate-100"
              >
                <img
                  src="https://images.unsplash.com/photo-1556679343-c7306c1976bc?auto=format&fit=crop&w=600&q=80"
                  alt="Es Teh Manis Jumbo"
                  class="h-24 w-24 object-cover transition hover:scale-105 sm:h-28 sm:w-28"
                />
              </a>

              <!-- Detail Produk -->
              <div class="min-w-0 flex-1">
                <div class="flex items-start justify-between gap-3">
                  <div>
                    <p class="text-xs font-semibold text-blue-600">Minuman</p>
                    <a
                      href="/products/2"
                      class="mt-1 block font-bold text-slate-900 hover:text-blue-600"
                    >
                      Es Teh Manis Jumbo
                    </a>
                  </div>

                  <!-- Tombol Hapus -->
                  <button
                    type="button"
                    class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl text-slate-400 transition hover:bg-red-50 hover:text-red-500"
                    aria-label="Hapus item"
                  >
                    <i data-lucide="trash-2" class="h-4 w-4"></i>
                  </button>
                </div>

                <div
                  class="mt-5 flex flex-wrap items-center justify-between gap-3"
                >
                  <!-- Control Quantity -->
                  <div
                    class="flex items-center rounded-xl border border-slate-200"
                  >
                    <button
                      type="button"
                      class="flex h-9 w-9 items-center justify-center text-slate-500 transition hover:bg-slate-50 hover:text-slate-900"
                    >
                      <i data-lucide="minus" class="h-3.5 w-3.5"></i>
                    </button>

                    <span
                      class="w-9 text-center text-sm font-bold text-slate-900"
                    >
                      1
                    </span>

                    <button
                      type="button"
                      class="flex h-9 w-9 items-center justify-center text-slate-500 transition hover:bg-slate-50 hover:text-slate-900"
                    >
                      <i data-lucide="plus" class="h-3.5 w-3.5"></i>
                    </button>
                  </div>

                  <!-- Harga -->
                  <div class="text-right">
                    <p class="text-xs text-slate-400">Rp 5.000 × 1</p>
                    <p class="mt-0.5 font-black text-slate-900">Rp 5.000</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- SIDEBAR RINGKASAN PESANAN -->
        <aside class="lg:sticky lg:top-24">
          <div
            class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6"
          >
            <h2 class="text-lg font-black text-slate-900">Ringkasan Pesanan</h2>

            <div class="mt-6 space-y-3 text-sm">
              <div class="flex items-center justify-between">
                <span class="text-slate-500">Jumlah item</span>
                <span class="font-semibold text-slate-900">3</span>
              </div>

              <div class="flex items-center justify-between">
                <span class="text-slate-500">Subtotal</span>
                <span class="font-semibold text-slate-900">Rp 35.000</span>
              </div>
            </div>

            <div class="my-5 h-px bg-slate-200"></div>

            <div class="flex items-center justify-between">
              <span class="font-bold text-slate-900">Total</span>
              <span class="text-xl font-black text-blue-600">Rp 35.000</span>
            </div>

            <a
              href="/checkout.html"
              class="mt-6 flex w-full items-center justify-center rounded-xl bg-blue-600 px-5 py-3.5 font-bold text-white shadow-lg shadow-blue-600/20 transition hover:bg-blue-700"
            >
              Lanjut ke Checkout
            </a>

            <a
              href="/products.html"
              class="mt-3 flex w-full items-center justify-center rounded-xl border border-slate-200 bg-white px-5 py-3.5 text-sm font-semibold text-slate-600 transition hover:bg-slate-50"
            >
              Tambah Menu
            </a>
          </div>
        </aside>
      </div>
    </main>

<%- include('../../partials/footer') %>
