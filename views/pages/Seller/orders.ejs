<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Pesanan Masuk' %></title>
  
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="bg-slate-50 font-sans antialiased flex flex-col min-h-screen">

  <!-- MAIN CONTENT -->
  <main class="grow mx-auto max-w-7xl w-full px-4 py-8 sm:px-6 lg:px-8">
    
    <div class="mb-6">
      <h1 class="text-2xl font-black text-slate-900 tracking-tight">Daftar Pesanan Pembeli</h1>
      <p class="text-xs text-slate-500 mt-1">Kelola dan perbarui status pesanan makanan yang masuk ke toko Anda.</p>
    </div>

    <% if (orders && orders.length > 0) { %>
      <div class="grid gap-4">
        <% orders.forEach(order => { %>
          <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm flex flex-col sm:flex-row justify-between gap-6">
            
            <!-- DETAIL PESANAN -->
            <div class="grow">
              <div class="flex items-center gap-3 mb-2">
                <span class="font-bold text-slate-900 text-sm">#ORD-<%= order.id %></span>
                <span class="text-xs text-slate-400">• <%= new Date(order.created_at).toLocaleString('id-ID') %></span>
                
                <!-- BADGE STATUS -->
                <% 
                  let statusBg = 'bg-amber-50 text-amber-700 border-amber-200';
                  let statusText = 'Pending';
                  if (order.status === 'processing') { statusBg = 'bg-blue-50 text-blue-700 border-blue-200'; statusText = 'Diproses'; }
                  else if (order.status === 'completed') { statusBg = 'bg-indigo-50 text-indigo-700 border-indigo-200'; statusText = 'Selesai'; }
                  else if (order.status === 'cancelled') { statusBg = 'bg-rose-50 text-rose-700 border-rose-200'; statusText = 'Dibatalkan'; }
                %>
                <span class="inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-bold <%= statusBg %>">
                  <%= statusText %>
                </span>
              </div>

              <p class="text-xs font-semibold text-slate-700 mb-3">Pembeli: <span class="font-bold text-slate-900"><%= order.customer_name %></span></p>

              <!-- ITEM PESANAN -->
              <div class="bg-slate-50 rounded-xl p-3 border border-slate-100 space-y-1.5">
                <% if (order.items && order.items.length > 0) { %>
                  <% order.items.forEach(item => { %>
                    <div class="flex justify-between text-xs text-slate-600">
                      <span><%= item.product_name %> <strong class="text-slate-900">x<%= item.quantity %></strong></span>
                      <span class="font-semibold">Rp <%= Number(item.price * item.quantity).toLocaleString('id-ID') %></span>
                    </div>
                  <% }) %>
                <% } else { %>
                  <p class="text-xs text-slate-400">Tidak ada rincian item.</p>
                <% } %>
              </div>

              <div class="mt-3 flex justify-between items-center text-sm font-black text-slate-900">
                <span>Total Pembayaran:</span>
                <span class="text-indigo-600">Rp <%= Number(order.total_price).toLocaleString('id-ID') %></span>
              </div>
            </div>

            <!-- AKSI UBAH STATUS -->
            <div class="flex sm:flex-col justify-end items-end gap-2 border-t sm:border-t-0 sm:border-l border-slate-100 pt-4 sm:pt-0 sm:pl-6">
              <% if (order.status === 'pending') { %>
                <form action="/seller/orders/<%= order.id %>/status?_method=PATCH" method="POST" class="w-full">
                  <input type="hidden" name="status" value="processing">
                  <button type="submit" class="w-full rounded-xl bg-indigo-600 px-4 py-2 text-xs font-bold text-white hover:bg-indigo-700 transition">
                    Proses Pesanan
                  </button>
                </form>
              <% } else if (order.status === 'processing') { %>
                <form action="/seller/orders/<%= order.id %>/status?_method=PATCH" method="POST" class="w-full">
                  <input type="hidden" name="status" value="completed">
                  <button type="submit" class="w-full rounded-xl bg-indigo-600 px-4 py-2 text-xs font-bold text-white hover:bg-indigo-700 transition">
                    Selesaikan Pesanan
                  </button>
                </form>
              <% } %>

              <% if (order.status !== 'completed' && order.status !== 'cancelled') { %>
                <form action="/seller/orders/<%= order.id %>/status?_method=PATCH" method="POST" class="w-full">
                  <input type="hidden" name="status" value="cancelled">
                  <button type="submit" class="w-full rounded-xl border border-rose-200 bg-rose-50 px-4 py-2 text-xs font-bold text-rose-600 hover:bg-rose-100 transition">
                    Batalkan
                  </button>
                </form>
              <% } %>
            </div>

          </div>
        <% }) %>
      </div>
    <% } else { %>
      <!-- EMPTY STATE -->
      <div class="rounded-2xl border border-slate-200 bg-white p-12 text-center">
        <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-slate-100 text-slate-400 mb-3">
          <i data-lucide="inbox" class="h-6 w-6"></i>
        </div>
        <h3 class="text-sm font-bold text-slate-900">Belum Ada Pesanan</h3>
        <p class="text-xs text-slate-400 mt-1">Pesanan masuk dari pembeli akan muncul di halaman ini.</p>
      </div>
    <% } %>

  </main>

  <script>
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }

    <% 
    // Cek apakah di daftar pesanan ada yang statusnya belum selesai/batal
    const hasPendingOrProcessing = orders && orders.some(o => o.status === 'pending' || o.status === 'processing');
  %>

  <% if (hasPendingOrProcessing) { %>
    console.log("Ada pesanan butuh tindakan seller. Auto-refresh aktif...");
    setInterval(() => {
      window.location.reload();
    }, 10000); // Reload tiap 10 detik
  <% } %>
  </script>
</body>
</html>