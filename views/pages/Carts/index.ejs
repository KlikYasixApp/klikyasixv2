<% 
  var title = "Keranjang Belanja - Kantin"; 
  var page = "cart"; 

  // Mengambil data dari controller Express (req.session.cart)
  var items = (typeof carts !== 'undefined' && carts) ? carts : [];
%>

<main class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
  <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl font-black text-slate-900 sm:text-3xl">Keranjang Belanja</h1>
      <p class="mt-1 text-sm text-slate-500">Periksa kembali pesanan Anda sebelum checkout.</p>
    </div>
    
    <% if (items.length > 0) { %>
      <a href="/" class="inline-flex items-center gap-2 text-sm font-bold text-blue-600 hover:text-blue-700">
        <i data-lucide="arrow-left" class="h-4 w-4"></i>
        Tambah Menu Lain
      </a>
    <% } %>
  </div>

  <% if (items.length > 0) { %>
    <!-- TAMPILAN KERANJANG TERISI -->
    <div class="grid gap-6 lg:grid-cols-[1fr_380px] lg:items-start">
      
      <!-- LIST ITEM KERANJANG -->
      <div class="space-y-4">
        <% 
          let totalItems = 0;
          let grandTotal = 0;
          items.forEach(function(item) { 
            const itemSubtotal = item.price * item.quantity;
            totalItems += item.quantity;
            grandTotal += itemSubtotal;
        %>
          <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm transition hover:border-slate-300 sm:p-5">
            <div class="flex gap-4">
              <!-- Gambar Makanan / Minuman -->
              <div class="h-24 w-24 shrink-0 overflow-hidden rounded-xl bg-slate-100 sm:h-28 sm:w-28">
                <img
                  src="<%= item.image || 'https://images.unsplash.com/photo-1546069901-ba9599a7e63c?auto=format&fit=crop&w=600&q=80' %>"
                  alt="<%= item.name %>"
                  class="h-full w-full object-cover"
                />
              </div>

              <!-- Detail Makanan -->
              <div class="flex min-w-0 flex-1 flex-col justify-between">
                <div>
                  <div class="flex items-start justify-between gap-2">
                    <div>
                      <span class="inline-block rounded-md bg-blue-50 px-2 py-0.5 text-[10px] font-bold tracking-wide text-blue-600 uppercase">
                        <%= item.store_name || 'Kantin' %>
                      </span>
                      <h3 class="mt-1 font-bold text-slate-900 line-clamp-1 sm:text-base">
                        <%= item.name %>
                      </h3>
                    </div>

                    <!-- Form Tombol Hapus -->
                    <form action="/carts/item/<%= item.id %>?_method=DELETE" method="POST">
                      <button
                        type="submit"
                        class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg text-slate-400 transition hover:bg-red-50 hover:text-red-500 cursor-pointer"
                        title="Hapus Item"
                      >
                        <i data-lucide="trash-2" class="h-4 w-4"></i>
                      </button>
                    </form>
                  </div>
                </div>

                <div class="mt-3 flex flex-wrap items-end justify-between gap-3">
                  <!-- Control Jumlah (Quantity) -->
                  <div class="flex items-center rounded-xl border border-slate-200 bg-slate-50/50">
                    <!-- Tombol Minus -->
                    <form action="/carts" method="POST" class="inline">
                      <input type="hidden" name="product_id" value="<%= item.id %>">
                      <input type="hidden" name="quantity" value="-1">
                      <button
                        type="submit"
                        class="flex h-8 w-8 items-center justify-center rounded-l-xl text-slate-500 hover:bg-slate-200/60 hover:text-slate-900 active:scale-95 transition cursor-pointer"
                        <%= item.quantity <= 1 ? 'disabled' : '' %>
                      >
                        <i data-lucide="minus" class="h-3.5 w-3.5"></i>
                      </button>
                    </form>

                    <span class="w-8 text-center text-xs font-bold text-slate-900">
                      <%= item.quantity %>
                    </span>

                    <!-- Tombol Plus -->
                    <form action="/carts" method="POST" class="inline">
                      <input type="hidden" name="product_id" value="<%= item.id %>">
                      <input type="hidden" name="quantity" value="1">
                      <button
                        type="submit"
                        class="flex h-8 w-8 items-center justify-center rounded-r-xl text-slate-500 hover:bg-slate-200/60 hover:text-slate-900 active:scale-95 transition cursor-pointer"
                      >
                        <i data-lucide="plus" class="h-3.5 w-3.5"></i>
                      </button>
                    </form>
                  </div>

                  <!-- Perhitungan Harga -->
                  <div class="text-right">
                    <p class="text-[11px] font-medium text-slate-400">
                      Rp <%= Number(item.price).toLocaleString('id-ID') %> × <%= item.quantity %>
                    </p>
                    <p class="text-base font-black text-slate-900">
                      Rp <%= itemSubtotal.toLocaleString('id-ID') %>
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        <% }); %>
      </div>

      <!-- SIDEBAR RINGKASAN HARGA & CHECKOUT -->
      <aside class="lg:sticky lg:top-24">
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
          <h2 class="text-lg font-black text-slate-900">Ringkasan Pembayaran</h2>

          <div class="mt-5 space-y-3 text-sm">
            <div class="flex items-center justify-between text-slate-600">
              <span>Total Porsi</span>
              <span class="font-bold text-slate-900"><%= totalItems %> Item</span>
            </div>

            <div class="flex items-center justify-between text-slate-600">
              <span>Subtotal Makanan</span>
              <span class="font-bold text-slate-900">
                Rp <%= grandTotal.toLocaleString('id-ID') %>
              </span>
            </div>

            <div class="flex items-center justify-between text-slate-600">
              <span>Biaya Layanan</span>
              <span class="font-bold text-emerald-600">Gratis</span>
            </div>
          </div>

          <div class="my-5 h-px bg-slate-100"></div>

          <div class="flex items-center justify-between">
            <span class="font-bold text-slate-900">Total Pembayaran</span>
            <span class="text-xl font-black text-blue-600">
              Rp <%= grandTotal.toLocaleString('id-ID') %>
            </span>
          </div>

          <!-- Tombol Aksi -->
          <a
            href="/checkout"
            class="mt-6 flex w-full items-center justify-center gap-2 rounded-xl bg-blue-600 py-3.5 font-bold text-white shadow-lg shadow-blue-600/20 transition hover:bg-blue-700 active:scale-[0.99]"
          >
            <span>Lanjut ke Checkout</span>
            <i data-lucide="arrow-right" class="h-4 w-4"></i>
          </a>

          <p class="mt-3 text-center text-xs text-slate-400">
            *Pesanan dapat diambil atau diantar ke meja kantin.
          </p>
        </div>
      </aside>

    </div>

  <% } else { %>
    <!-- TAMPILAN KERANJANG KOSONG (EMPTY STATE) -->
    <div class="mx-auto my-12 max-w-sm rounded-3xl border border-slate-100 bg-white p-8 text-center shadow-sm">
      <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-2xl bg-blue-50 text-blue-600">
        <i data-lucide="shopping-bag" class="h-10 w-10"></i>
      </div>
      <h2 class="mt-5 text-lg font-bold text-slate-900">Keranjang Masih Kosong</h2>
      <p class="mt-2 text-xs leading-relaxed text-slate-500">
        Belum ada makanan atau minuman yang kamu pilih. Yuk, cari menu favoritmu sekarang!
      </p>
      <a
        href="/"
        class="mt-6 inline-flex w-full items-center justify-center gap-2 rounded-xl bg-blue-600 py-3 text-sm font-bold text-white shadow-md shadow-blue-600/20 transition hover:bg-blue-700"
      >
        Lihat Menu Kantin
        <i data-lucide="arrow-right" class="h-4 w-4"></i>
      </a>
    </div>
  <% } %>
</main>

<script>
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }
</script>