<% 
  var title = typeof title !== 'undefined' ? title : "Pesanan Saya - Kantin Digital"; 
  var page = "orders"; 
  const orderList = typeof orders !== 'undefined' ? orders : [];
  const latestOrderId = typeof newOrderId !== 'undefined' ? newOrderId : null;
%>


<main class="min-h-screen bg-slate-50">
  <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:px-8">

    <!-- BANNER SUCCESS NOTIFICATION (Tampil jika baru selesai checkout) -->
    <% if (latestOrderId) { %>
      <div class="mb-6 flex gap-4 rounded-2xl border border-blue-200 bg-blue-50 p-5 shadow-xs">
        <i data-lucide="check-circle-2" class="h-6 w-6 shrink-0 text-blue-600"></i>
        <div>
          <h2 class="font-bold text-blue-900">Pesanan berhasil dibuat!</h2>
          <p class="mt-0.5 text-sm text-blue-700">
            Nomor pesanan:
            <span class="font-mono font-bold">#ORD-<%= latestOrderId %></span>
          </p>
        </div>
      </div>
    <% } %>

    <div class="mb-6 flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-black text-slate-900 sm:text-3xl">Pesanan Saya</h1>
        <p class="mt-1 text-sm text-slate-500">Pantau status makanan dan minuman yang kamu pesan.</p>
      </div>
    </div>

    <!-- DAFTAR PESANAN -->
    <% if (orderList.length > 0) { %>
      <div class="space-y-5">
        <% orderList.forEach((order) => { %>
          <a
            href="/orders/<%= order.id %>"
            class="group block overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition hover:-translate-y-0.5 hover:border-blue-300 hover:shadow-md"
          >
            <!-- Header Card -->
            <div class="flex flex-col gap-3 border-b border-slate-100 p-5 sm:flex-row sm:items-center sm:justify-between">
              <div>
                <p class="text-[11px] font-bold tracking-wider text-slate-400 uppercase">
                  NOMOR PESANAN
                </p>
                <p class="mt-0.5 font-bold text-slate-900">#ORD-<%= order.id %></p>
              </div>

              <!-- Status Badge Dinamis -->
              <% if (order.status === 'pending') { %>
                <div class="flex w-fit items-center gap-1.5 rounded-full bg-yellow-50 px-3 py-1 text-xs font-bold text-yellow-700">
                  <i data-lucide="clock-3" class="h-3.5 w-3.5"></i>
                  Menunggu Konfirmasi
                </div>
              <% } else if (order.status === 'processing') { %>
                <div class="flex w-fit items-center gap-1.5 rounded-full bg-blue-50 px-3 py-1 text-xs font-bold text-blue-700">
                  <i data-lucide="utensils" class="h-3.5 w-3.5"></i>
                  Sedang Disiapkan
                </div>
              <% } else if (order.status === 'completed') { %>
                <div class="flex w-fit items-center gap-1.5 rounded-full bg-emerald-50 px-3 py-1 text-xs font-bold text-emerald-700">
                  <i data-lucide="check-circle-2" class="h-3.5 w-3.5"></i>
                  Selesai / Siap Diambil
                </div>
              <% } else { %>
                <div class="flex w-fit items-center gap-1.5 rounded-full bg-slate-100 px-3 py-1 text-xs font-bold text-slate-600">
                  <%= order.status %>
                </div>
              <% } %>
            </div>

            <!-- Item List -->
            <div class="divide-y divide-slate-100">
              <% if (order.items && order.items.length > 0) { %>
                <% order.items.forEach((item) => { %>
                  <div class="flex gap-4 p-5">
                    <div class="h-14 w-14 shrink-0 overflow-hidden rounded-xl bg-slate-100">
                      <% if (imageUrl(item.image)) { %>
                        <img
                          src="<%= imageUrl(item.image) %>"
                          alt="<%= item.product_name %>"
                          class="h-full w-full object-cover"
                          onerror="this.onerror=null; this.src='/yadika.png';"
                        />
                      <% } else { %>
                        <div class="flex h-full w-full items-center justify-center text-slate-300">
                          <i data-lucide="utensils" class="h-6 w-6"></i>
                        </div>
                      <% } %>
                    </div>

                    <div class="min-w-0 flex-1">
                      <p class="font-bold text-slate-900"><%= item.product_name %></p>
                      <p class="mt-1 text-sm text-slate-500">
                        <%= item.quantity %> × Rp <%= Number(item.price).toLocaleString('id-ID') %>
                      </p>
                    </div>

                    <p class="font-bold text-slate-900">
                      Rp <%= (Number(item.price) * item.quantity).toLocaleString('id-ID') %>
                    </p>
                  </div>
                <% }); %>
              <% } else { %>
                <div class="p-5 text-sm text-slate-400">Rincian menu tidak tersedia.</div>
              <% } %>
            </div>

            <!-- Footer Card -->
            <div class="flex items-center justify-between border-t border-slate-100 bg-slate-50/70 p-5">
              <div>
                <p class="text-xs text-slate-400">Total Pesanan</p>
                <p class="mt-0.5 font-black text-blue-600">
                  Rp <%= Number(order.total_price).toLocaleString('id-ID') %>
                </p>
              </div>

              <span class="flex items-center gap-1 text-sm font-bold text-slate-600 transition group-hover:text-blue-600">
                Lihat Detail
                <i data-lucide="arrow-right" class="h-4 w-4 transition group-hover:translate-x-1"></i>
              </span>
            </div>
          </a>
        <% }); %>
      </div>
    <% } else { %>
      <!-- STATE PESANAN KOSONG -->
      <div class="mx-auto my-12 max-w-sm rounded-3xl border border-slate-100 bg-white p-8 text-center shadow-sm">
        <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-2xl bg-blue-50 text-blue-600">
          <i data-lucide="receipt" class="h-10 w-10"></i>
        </div>
        <h2 class="mt-5 text-lg font-bold text-slate-900">Belum Ada Pesanan</h2>
        <p class="mt-2 text-xs leading-relaxed text-slate-500">
          Kamu belum pernah melakukan pemesanan makanan. Yuk, pesan sekarang!
        </p>
        <a
          href="/"
          class="mt-6 inline-flex w-full items-center justify-center gap-2 rounded-xl bg-blue-600 py-3 text-sm font-bold text-white shadow-md shadow-blue-600/20 transition hover:bg-blue-700"
        >
          Lihat Menu Kantin
          <i data-lucide="arrow-right" class="h-4 w-4"></i>
        </a>
      </div>
    <% } %>

    <!-- REFRESH STATUS -->
    <div class="mt-8 flex items-center justify-center gap-2 text-xs text-slate-400">
      <span class="h-2 w-2 animate-pulse rounded-full bg-blue-500"></span>
      Status pesanan diperbarui secara otomatis
    </div>
  </div>
</main>


<script>
  try {
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  } catch (e) {
    return;
  }

  <% 
    var hasActiveOrders = false;
    if (typeof orders !== 'undefined' && Array.isArray(orders)) {
      hasActiveOrders = orders.some(function(o) {
        return o.status !== 'completed' && o.status !== 'cancelled';
      });
    }
  %>

  <% if (hasActiveOrders) { %>
    setInterval(() => {
      window.location.reload();
    }, 10000);
  <% } else { %>
  <% } %>
</script>