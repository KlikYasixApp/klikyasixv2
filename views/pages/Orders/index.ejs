<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Pesanan Saya - Kantin</title>
    <!-- Tailwind CSS Browser CDN -->
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <!-- Lucide Icons CDN -->
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-900">
    <!-- HEADER PAGE -->
    <section class="border-b border-slate-200 bg-white">
      <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
        <p class="text-sm font-semibold text-green-600">RIWAYAT</p>
        <h1 class="mt-2 text-3xl font-black tracking-tight text-slate-900">
          Pesanan Saya
        </h1>
        <p class="mt-2 text-sm text-slate-500">
          Lihat status dan detail pesananmu.
        </p>
      </div>
    </section>

    <!-- CONTENT MAIN -->
    <main class="mx-auto max-w-4xl px-4 py-10 sm:px-6 lg:px-8">
      <!-- BANNER PESANAN BERHASIL (SUCCESS ALERT) -->
      <div
        class="mb-6 flex gap-4 rounded-2xl border border-green-200 bg-green-50 p-5"
      >
        <i
          data-lucide="check-circle-2"
          class="h-6 w-6 shrink-0 text-green-600"
        ></i>
        <div>
          <h2 class="font-bold text-green-800">Pesanan berhasil dibuat!</h2>
          <p class="mt-1 text-sm text-green-700">
            Nomor pesanan: <span class="font-bold">ORD-2026-002</span>
          </p>
        </div>
      </div>

      <!-- DAFTAR PESANAN (ORDER LIST) -->
      <div class="space-y-5">
        <!-- ORDER CARD 1: MENUNGGU -->
        <a
          href="/orders/ORD-2026-002.html"
          class="group block overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition hover:-translate-y-0.5 hover:border-green-200 hover:shadow-md"
        >
          <!-- Card Header -->
          <div
            class="flex flex-col gap-4 border-b border-slate-100 p-5 sm:flex-row sm:items-center sm:justify-between"
          >
            <div>
              <p class="text-xs font-semibold text-slate-400">NOMOR PESANAN</p>
              <p class="mt-1 font-bold text-slate-900">ORD-2026-002</p>
            </div>

            <!-- Status Badge -->
            <div
              class="flex w-fit items-center gap-2 rounded-full bg-yellow-50 px-3 py-1.5 text-xs font-bold text-yellow-700"
            >
              <i data-lucide="clock-3" class="h-3.5 w-3.5"></i>
              Menunggu
            </div>
          </div>

          <!-- Items List -->
          <div class="divide-y divide-slate-100">
            <!-- Item 1 -->
            <div class="flex gap-4 p-5">
              <div
                class="h-14 w-14 shrink-0 overflow-hidden rounded-xl bg-slate-100"
              >
                <img
                  src="https://images.unsplash.com/photo-1603133872878-684f208fb84b?auto=format&fit=crop&w=300&q=80"
                  alt="Nasi Goreng Spesial"
                  class="h-full w-full object-cover"
                />
              </div>

              <div class="min-w-0 flex-1">
                <p class="font-bold text-slate-900">Nasi Goreng Spesial</p>
                <p class="mt-1 text-sm text-slate-500">2 × Rp 15.000</p>
              </div>

              <p class="font-bold text-slate-900">Rp 30.000</p>
            </div>

            <!-- Item 2 -->
            <div class="flex gap-4 p-5">
              <div
                class="h-14 w-14 shrink-0 overflow-hidden rounded-xl bg-slate-100"
              >
                <img
                  src="https://images.unsplash.com/photo-1556679343-c7306c1976bc?auto=format&fit=crop&w=300&q=80"
                  alt="Es Teh Manis Jumbo"
                  class="h-full w-full object-cover"
                />
              </div>

              <div class="min-w-0 flex-1">
                <p class="font-bold text-slate-900">Es Teh Manis Jumbo</p>
                <p class="mt-1 text-sm text-slate-500">1 × Rp 5.000</p>
              </div>

              <p class="font-bold text-slate-900">Rp 5.000</p>
            </div>
          </div>

          <!-- Card Footer -->
          <div
            class="flex items-center justify-between border-t border-slate-100 bg-slate-50 p-5"
          >
            <div>
              <p class="text-xs text-slate-400">Total Pesanan</p>
              <p class="mt-1 font-black text-green-600">Rp 35.000</p>
            </div>

            <span
              class="flex items-center gap-1 text-sm font-bold text-slate-500 transition group-hover:text-green-600"
            >
              Detail
              <i
                data-lucide="arrow-right"
                class="h-4 w-4 transition group-hover:translate-x-1"
              ></i>
            </span>
          </div>
        </a>

        <!-- ORDER CARD 2: SIAP DIAMBIL (> 3 ITEM) -->
        <a
          href="/orders/ORD-2026-001.html"
          class="group block overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition hover:-translate-y-0.5 hover:border-green-200 hover:shadow-md"
        >
          <!-- Card Header -->
          <div
            class="flex flex-col gap-4 border-b border-slate-100 p-5 sm:flex-row sm:items-center sm:justify-between"
          >
            <div>
              <p class="text-xs font-semibold text-slate-400">NOMOR PESANAN</p>
              <p class="mt-1 font-bold text-slate-900">ORD-2026-001</p>
            </div>

            <!-- Status Badge -->
            <div
              class="flex w-fit items-center gap-2 rounded-full bg-green-50 px-3 py-1.5 text-xs font-bold text-green-700"
            >
              <i data-lucide="check-circle-2" class="h-3.5 w-3.5"></i>
              Siap Diambil
            </div>
          </div>

          <!-- Items List (3 item pertama) -->
          <div class="divide-y divide-slate-100">
            <div class="flex gap-4 p-5">
              <div
                class="h-14 w-14 shrink-0 overflow-hidden rounded-xl bg-slate-100"
              >
                <img
                  src="https://images.unsplash.com/photo-1565299624946-b28f40a0ae38?auto=format&fit=crop&w=300&q=80"
                  alt="Ayam Geprek Sambal Korek"
                  class="h-full w-full object-cover"
                />
              </div>

              <div class="min-w-0 flex-1">
                <p class="font-bold text-slate-900">Ayam Geprek Sambal Korek</p>
                <p class="mt-1 text-sm text-slate-500">1 × Rp 18.000</p>
              </div>

              <p class="font-bold text-slate-900">Rp 18.000</p>
            </div>

            <div class="flex gap-4 p-5">
              <div
                class="h-14 w-14 shrink-0 overflow-hidden rounded-xl bg-slate-100"
              >
                <div
                  class="flex h-full w-full items-center justify-center text-slate-400"
                >
                  <i data-lucide="package" class="h-5 w-5"></i>
                </div>
              </div>

              <div class="min-w-0 flex-1">
                <p class="font-bold text-slate-900">Air Mineral 600ml</p>
                <p class="mt-1 text-sm text-slate-500">2 × Rp 3.000</p>
              </div>

              <p class="font-bold text-slate-900">Rp 6.000</p>
            </div>

            <div class="flex gap-4 p-5">
              <div
                class="h-14 w-14 shrink-0 overflow-hidden rounded-xl bg-slate-100"
              >
                <div
                  class="flex h-full w-full items-center justify-center text-slate-400"
                >
                  <i data-lucide="package" class="h-5 w-5"></i>
                </div>
              </div>

              <div class="min-w-0 flex-1">
                <p class="font-bold text-slate-900">Kerupuk Bawang</p>
                <p class="mt-1 text-sm text-slate-500">2 × Rp 2.000</p>
              </div>

              <p class="font-bold text-slate-900">Rp 4.000</p>
            </div>
          </div>

          <!-- Indicator item tambahan jika > 3 -->
          <div
            class="border-t border-slate-100 px-5 py-3 text-xs font-semibold text-slate-400"
          >
            + 1 item lainnya
          </div>

          <!-- Card Footer -->
          <div
            class="flex items-center justify-between border-t border-slate-100 bg-slate-50 p-5"
          >
            <div>
              <p class="text-xs text-slate-400">Total Pesanan</p>
              <p class="mt-1 font-black text-green-600">Rp 31.000</p>
            </div>

            <span
              class="flex items-center gap-1 text-sm font-bold text-slate-500 transition group-hover:text-green-600"
            >
              Detail
              <i
                data-lucide="arrow-right"
                class="h-4 w-4 transition group-hover:translate-x-1"
              ></i>
            </span>
          </div>
        </a>
      </div>

      <!-- REFRESH INDICATOR FOOTER -->
      <div
        class="mt-6 flex items-center justify-center gap-2 text-xs text-slate-400"
      >
        <span class="h-2 w-2 animate-pulse rounded-full bg-green-500"></span>
        Status pesanan diperbarui otomatis
      </div>

      <!-- BONUS: EMPTY STATE DISPLAY (Bisa di-uncomment kalau riwayat kosong) -->
      <!-- 
      <div class="mx-auto flex min-h-[50vh] max-w-7xl items-center justify-center px-4 py-16">
        <div class="text-center">
          <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-3xl bg-green-50 text-green-600">
            <i data-lucide="package" class="h-9 w-9"></i>
          </div>

          <h1 class="mt-6 text-2xl font-black text-slate-900">
            Belum ada pesanan
          </h1>

          <p class="mt-3 text-sm text-slate-500">
            Pesanan yang kamu buat akan muncul di sini.
          </p>

          <a
            href="/products.html"
            class="mt-7 inline-flex items-center gap-2 rounded-xl bg-green-600 px-6 py-3.5 font-bold text-white transition hover:bg-green-700"
          >
            <i data-lucide="shopping-bag" class="h-4 w-4"></i>
            Pesan Sekarang
          </a>
        </div>
      </div>
      -->
    </main>

    <!-- Inisialisasi Lucide Icon -->
    <script>
      lucide.createIcons();
    </script>
  </body>
</html>
